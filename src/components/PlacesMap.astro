---
import Icon from './Icon.astro';
const q = (s: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(s)}`;
const groups = [
  { title: 'Getting around', icon: 'bus', items: [
    { t: 'Cascais train station', n: 'End of the Cascais line', u: q('Estação de Cascais') },
    { t: 'Bus terminal', n: 'Search for the Cascais bus terminal', u: q('Cascais bus terminal') },
  ]},
  { title: 'Town centre', icon: 'landmark', items: [
    { t: 'Rua Amarela (Yellow Street)', n: 'Pedestrian dining street in the historic centre', u: q('Rua Amarela Cascais') },
    { t: 'Mercado da Vila (market)', n: 'Town market', u: q('Mercado da Vila Cascais') },
    { t: 'Loja Cascais', n: 'Local-government service office', u: q('Loja Cascais') },
    { t: 'City hall', n: 'Câmara Municipal de Cascais, the local government offices', u: q('Câmara Municipal de Cascais') },
  ]},
  { title: 'Beaches', icon: 'sun', items: [
    { t: 'Praia da Ribeira (beach)', n: 'In the town centre', u: q('Praia da Ribeira Cascais') },
    { t: 'Praia da Rainha (beach)', n: 'Small central beach', u: q('Praia da Rainha Cascais') },
    { t: 'Praia da Conceição (beach)', n: 'Near the centre', u: q('Praia da Conceição Cascais') },
  ]},
];
---
<div class="places-in" aria-label="Map of Cascais">
  <h3 class="pl-h"><Icon name="map-pin" />New to Cascais? Start with a map</h3>
  <p class="muted">An interactive map of central Cascais with its main sights and beaches, from the independent guide Cascais-Portugal.com. It does not mark the train station, bus terminal, market, Loja Cascais (local-government service office) or town hall, so use the place links for those.</p>
  <p class="pl-btn-wrap"><a class="pl-btn" href="https://www.cascais-portugal.com/Guides/cascais-map.html" target="_blank" rel="noopener noreferrer"><Icon name="map-pin" />Open the Cascais map</a></p>
  <details class="pl-more">
    <summary>Find a specific place in Google Maps</summary>
    <div class="pl-grid">
      {groups.map(g => (
        <div class="pl-col">
          <h3><Icon name={g.icon} />{g.title}</h3>
          <ul>
            {g.items.map(i => (
              <li><a href={i.u} target="_blank" rel="noopener noreferrer"><strong>{i.t}</strong><span class="muted">{i.n}</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </details>
</div>
<style is:global>
  .places-in { margin:.9rem 0 .2rem; background:var(--surface); border-radius:14px; padding:.7rem .9rem .8rem; }
  .pl-h { display:flex; align-items:center; gap:.4rem; margin:0 0 .3rem; font-size:1rem; color:var(--teal); } .pl-h .i { --s:1.1em; }
  .pl-head { display:flex; align-items:center; gap:.6rem; margin-bottom:.3rem; }
  .pl-head h2 { font-size:1.15rem; margin:0; color:var(--teal); }
  .pl-head .ic { display:grid; place-items:center; width:2rem; height:2rem; border-radius:50%; background:var(--surface); color:var(--teal); } .pl-head .ic .i { --s:1.1rem; }
  .places-in > p { margin:.2rem 0 .7rem; font-size:.9rem; }
  .pl-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:.8rem; }
  .pl-col h3 { display:flex; align-items:center; gap:.4rem; font-size:.95rem; margin:0 0 .4rem; color:var(--teal); } .pl-col h3 .i { --s:1.1em; }
  .pl-col ul { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:.4rem; }
  .pl-col li a { display:flex; flex-direction:column; background:var(--teal-soft); border-radius:12px; padding:.5rem .75rem; text-decoration:none; color:var(--ink); font-size:.92rem; line-height:1.3; }
  .pl-col li a:hover { box-shadow:0 2px 10px var(--shadow); }
  .pl-col li a span { font-size:.82rem; }
  .places-in > p.pl-btn-wrap { text-align:center; margin:.4rem 0 .8rem; }
  .pl-btn { display:inline-flex; align-items:center; gap:.4rem; background:var(--teal); color:var(--bg); text-decoration:none; font-weight:800; padding:.55rem 1rem; border-radius:999px; } .pl-btn .i { --s:1.1em; }
  .pl-more { margin-top:.4rem; } .pl-more summary { cursor:pointer; font-weight:700; color:var(--teal); margin-bottom:.6rem; }
</style>
