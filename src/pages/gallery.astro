---
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import meta from '../gallery/gallery.json';
const files = import.meta.glob('../gallery/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
const byName = Object.fromEntries(Object.entries(files).map(([k, v]) => [k.split('/').pop()!, v]));
const items = await Promise.all(Object.entries(meta as Record<string, any>).filter(([f]) => byName[f]).map(async ([f, m]) => {
  const thumb = await getImage({ src: byName[f], width: 600, height: 600, fit: 'cover', format: 'webp' });
  const full = await getImage({ src: byName[f], width: 1600, format: 'webp' });
  return { m, thumb, full };
}));
---
<Base title="Photo gallery">
  <div class="gal">
    <p><a href="/">&larr; Home</a></p>
    <h1>Photo gallery</h1>
    <p class="muted">Tap a photo to see it larger, or <button type="button" id="start" class="slidebtn">&#9654; Start slide show</button></p>
    <ul class="grid">
      {items.map(({ m, thumb, full }) => (
        <li>
          <a href={full.src} data-cap={[m.caption, m.license].filter(Boolean).join(' · ')} data-alt={m.alt}>
            <img src={thumb.src} width="300" height="300" alt={m.alt} loading="lazy" decoding="async" />
          </a>
          {m.caption && <span class="cap">{m.caption}</span>}
          {m.license && <span class="cr">{m.source ? <a href={m.source} rel="noopener">{m.license}</a> : m.license}</span>}
        </li>
      ))}
    </ul>
    <p class="allcredit">All other photos by Todd. The first photo is by Michael Gaylard (CC BY 4.0), as credited under it.</p>
  </div>
  <dialog id="lb" aria-label="Photo viewer">
    <button type="button" class="x" aria-label="Close">&times;</button>
    <div class="stage">
      <button type="button" class="nav prev" aria-label="Previous photo">&#8249;</button>
      <img id="lbimg" alt="" />
      <button type="button" class="nav next" aria-label="Next photo">&#8250;</button>
    </div>
    <p id="lbcap"></p>
    <div class="bar">
      <button type="button" id="play" aria-pressed="false">&#9654; Play slide show</button>
      <span id="count" aria-live="polite"></span>
    </div>
  </dialog>
</Base>
<style is:global>
  .gal .grid{list-style:none;margin:1rem 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px}
  .gal .grid a{display:block;border-radius:18px;overflow:hidden;box-shadow:0 6px 18px var(--shadow);line-height:0}
  .gal .grid img{width:100%;height:auto;aspect-ratio:1;object-fit:cover;display:block}
  .gal .cap{display:block;font-weight:700;font-size:.92rem;margin-top:.4rem}
  .gal .allcredit{margin:2rem 0 0;text-align:center;font-size:.85rem;color:var(--muted)}
  .gal .cr{display:block;font-size:.78rem;color:var(--muted)}
  .gal .slidebtn{font:inherit;font-weight:700;color:var(--link,#1e4e8c);background:none;border:0;padding:0;cursor:pointer;text-decoration:underline}
  #lb{border:0;padding:0;background:transparent;width:min(96vw,1000px);max-height:96vh;color:#fff;text-align:center;overflow:visible;margin:auto}
  #lb::backdrop{background:rgba(10,16,28,.9)}
  #lb .stage{position:relative;touch-action:pan-y}
  #lb img{max-width:100%;max-height:72vh;border-radius:12px;display:block;margin:0 auto;user-select:none}
  #lb p{margin:.6rem 0 0;font-size:.95rem;min-height:2.6em}
  #lb .x{position:absolute;top:-2.4rem;right:0;background:none;border:0;color:#fff;font-size:2.2rem;line-height:1;cursor:pointer}
  #lb .nav{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;border:0;background:rgba(10,16,28,.55);color:#fff;font-size:2rem;line-height:1;cursor:pointer;display:grid;place-items:center;padding:0 0 4px}
  #lb .prev{left:6px}#lb .next{right:6px}
  #lb .nav:hover,#lb .nav:focus-visible{background:rgba(10,16,28,.85)}
  #lb .bar{display:flex;gap:1rem;justify-content:center;align-items:center;margin-top:.3rem;font-size:.9rem}
  #lb #play{font:inherit;font-weight:700;color:#fff;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.4);border-radius:999px;padding:.4rem 1rem;cursor:pointer}
  #lb #play[aria-pressed=true]{background:#fff;color:#14203a}
  #count{opacity:.85}
</style>
<script>
  const dlg = document.getElementById('lb') as HTMLDialogElement;
  const img = document.getElementById('lbimg') as HTMLImageElement;
  const cap = document.getElementById('lbcap')!;
  const count = document.getElementById('count')!;
  const play = document.getElementById('play') as HTMLButtonElement;
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.gal .grid a'));
  const DELAY = 4000;
  let idx = 0, timer: number | undefined;
  const show = (n: number) => {
    idx = (n + links.length) % links.length;
    const a = links[idx];
    img.src = a.href; img.alt = a.dataset.alt || ''; cap.textContent = a.dataset.cap || '';
    count.textContent = (idx + 1) + ' of ' + links.length;
    const nx = new Image(); nx.src = links[(idx + 1) % links.length].href;
  };
  const stop = () => { if (timer) clearInterval(timer); timer = undefined; play.setAttribute('aria-pressed', 'false'); play.innerHTML = '&#9654; Play slide show'; };
  const start = () => { stop(); timer = window.setInterval(() => show(idx + 1), DELAY); play.setAttribute('aria-pressed', 'true'); play.innerHTML = '&#10074;&#10074; Pause'; };
  const open = (n: number, autoplay = false) => { if (!links.length) return; show(n); if (!dlg.open) dlg.showModal(); autoplay ? start() : stop(); };
  links.forEach((a, n) => a.addEventListener('click', e => { e.preventDefault(); open(n); }));
  document.getElementById('start')?.addEventListener('click', () => open(0, true));
  const step = (d: number) => { show(idx + d); if (timer) start(); };
  dlg.querySelector('.prev')!.addEventListener('click', () => step(-1));
  dlg.querySelector('.next')!.addEventListener('click', () => step(1));
  play.addEventListener('click', () => timer ? stop() : start());
  dlg.querySelector('.x')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('close', stop);
  dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    else if (e.key === ' ' && e.target === dlg) { e.preventDefault(); timer ? stop() : start(); }
  });
  let x0 = 0, y0 = 0;
  const stage = dlg.querySelector('.stage')!;
  stage.addEventListener('touchstart', e => { const t = (e as TouchEvent).changedTouches[0]; x0 = t.clientX; y0 = t.clientY; }, { passive: true });
  stage.addEventListener('touchend', e => {
    const t = (e as TouchEvent).changedTouches[0], dx = t.clientX - x0, dy = t.clientY - y0;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
  }, { passive: true });
</script>
