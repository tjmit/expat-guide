---
import Base from '../layouts/Base.astro';
import QAList from '../components/QAList.astro';
import { getPhases, getQA } from '../lib/qa';
const phases = await getPhases();
const items = await getQA();
---
<Base title="Search all questions" wide>
  <h1>Search all questions</h1>
  <p class="muted">{items.length} questions across {phases.length} topics.</p>
  <QAList items={items} phases={phases} groupByPhase />
</Base>
